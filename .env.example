# ==========================================
# SILK BOARD SURVIVAL - ENVIRONMENT CONFIG
# ==========================================

# Anthropic Claude API Key (Required for Narrator)
# Get this from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxx

# C++ Engine Configuration
# The Next.js backend will call this URL to validate state.
ENGINE_URL=http://localhost:8080

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# X (Twitter) API Keys (Optional - For Trend Service)
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here